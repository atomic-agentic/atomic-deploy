# Copy to .env and set what differs on your host. .env is git-ignored.
# up.sh and check.sh read it; every value has the default shown.

# The model server, outside the cluster: an OpenAI-compatible server with the
# Responses API (/v1/responses), here Lemonade in Docker on the host. Pods
# reach the host on docker0.
MODEL_HOST_IP=172.17.0.1
MODEL_PORT=13305
MODEL_NAME=Qwen3.6-35B-A3B-MTP-GGUF-UD-Q4_K_XL

# The provider key agentgateway sends to the model server; no actor ever sees
# it. Lemonade checks none, so any value works there.
MODEL_PROVIDER_KEY=

# kagent's install requires a key for its default model provider (OpenAI). It
# is stored in kagent's default ModelConfig, which the atomic bridge never
# uses; set a real one only for kagent's own agents.
OPENAI_API_KEY=unused

# The Substrate atespace atomic's actors live in. agentgateway admits only
# actors from it.
ATESPACE=atomic

# gVisor workers for runner actors. Each holds one actor at a time.
WORKER_REPLICAS=2
