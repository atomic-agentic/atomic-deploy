    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Is telemetry from atomic arriving, and is any of it being dropped? Read this first when another dashboard is empty."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      }
    },
    {
      "type": "timeseries",
      "title": "Received by signal",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_spans[$__rate_interval]))",
          "legendFormat": "spans",
          "range": true,
          "instant": false,
          "exemplar": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points[$__rate_interval]))",
          "legendFormat": "metric points",
          "range": true,
          "instant": false,
          "exemplar": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_log_records[$__rate_interval]))",
          "legendFormat": "log records",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
