    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(deployment_environment_name)",
          "refId": "env"
        },
        "definition": "label_values(deployment_environment_name)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "workflow",
        "label": "Workflow",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(atomic_workflow_runs_total{deployment_environment_name=~\"$env\"}, atomic_workflow_name)",
          "refId": "workflow"
        },
        "definition": "label_values(atomic_workflow_runs_total{deployment_environment_name=~\"$env\"}, atomic_workflow_name)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
