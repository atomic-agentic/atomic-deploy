            "type": "grafana-postgresql-datasource",
            "uid": "atomic-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__unixEpochGroupAlias(completed_at / 1000, $__interval, 0), name AS metric, percentile_cont(0.95) WITHIN GROUP (ORDER BY (completed_at - created_at) / 1000.0) AS value FROM \"${durable_schema:raw}\".workflow_status WHERE completed_at BETWEEN $__unixEpochFrom()::bigint * 1000 AND $__unixEpochTo()::bigint * 1000 GROUP BY 1, 2 ORDER BY 1"
