          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__unixEpochGroupAlias(created_at / 1000, $__interval, 0), status AS metric, count(*) AS value FROM \"${durable_schema:raw}\".workflow_status WHERE created_at BETWEEN $__unixEpochFrom()::bigint * 1000 AND $__unixEpochTo()::bigint * 1000 GROUP BY 1, 2 ORDER BY 1"
