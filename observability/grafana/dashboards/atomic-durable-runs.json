    {
      "type": "table",
      "title": "Unfinished runs, oldest first",
      "description": "Run IDs belong in tables like this one, never in metric labels.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "atomic-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "atomic-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT workflow_uuid AS run, name AS workflow, status, executor_id AS executor, queue_name AS queue, recovery_attempts AS recoveries, to_timestamp(created_at / 1000.0) AS created, now() - to_timestamp(updated_at / 1000.0) AS idle_for FROM \"${durable_schema:raw}\".workflow_status WHERE status IN ('PENDING', 'ENQUEUED', 'DELAYED') ORDER BY created_at LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
