    {
      "type": "timeseries",
      "title": "Run duration p95 by workflow",
      "description": "From creation to a terminal state, gate waits included.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "atomic-postgres"
      },
      "targets": [
        {
          "refId": "A",
