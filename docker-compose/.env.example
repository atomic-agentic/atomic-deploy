# Copy to .env and set every password. .env is git-ignored.
#
# Generate passwords with: openssl rand -hex 24
# Hex matters for ATOMIC_DB_PASSWORD, which goes into a database URL as is:
# base64 output can contain / and +, which break the URL.
#
# Passwords are applied when the Postgres volume is first created. Changing
# them here afterwards does not change the database roles or Grafana's admin.

# Postgres superuser (setup only) and the three logins made on first start.
POSTGRES_PASSWORD=
ATOMIC_DB_PASSWORD=
ATOMIC_READER_PASSWORD=
ATOMIC_MONITOR_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# The model endpoint atomic's atoms call: an OpenAI-compatible Responses API.
# A server on the Docker host is reachable as host.docker.internal. Leave
# these commented out to use the project's atomic.yaml.
# ATOMIC_MODEL_BASE_URL=http://host.docker.internal:8000/v1
# ATOMIC_MODEL=

# The atomic project to run, and the name it is mounted under
# (/workspace/<name>). atomic keys its state by that path, so give each
# project its own name.
# ATOMIC_PROJECT_DIR=/path/to/your/project
# ATOMIC_PROJECT_NAME=project

# The project image: a directory holding a Dockerfile that starts
# FROM atomic-runtime and installs the toolchains the project's atom commands
# need. The directory is the build context, so keep it small. The default,
# ../docker/python, needs a uv project (pyproject.toml,
# uv.lock and .python-version in ATOMIC_PROJECT_DIR);
# ../docker/base adds nothing. See ../docker/README.md.
# ATOMIC_PROJECT_IMAGE_DIR=../docker/python

# What the atomic container runs (arguments to the atomic binary).
# ATOMIC_COMMAND=serve

# Tag for the locally built atomic image.
# ATOMIC_IMAGE_TAG=latest

# Unique to this atomic process and stable across restarts. Also reported as
# service.instance.id.
# ATOMIC_EXECUTOR_ID=compose-atomic-0

# Shown as deployment.environment.name on every signal.
# ATOMIC_ENVIRONMENT=compose

# Tail sampling. TRACE_SAMPLE_PERCENT is the share of routine traces kept.
# Below 100, a trace is judged TRACE_DECISION_WAIT after its first span, so
# only steps shorter than that are judged on their own outcome; see
# observability/metrics.md.
# TRACE_SAMPLE_PERCENT=100
# TRACE_DECISION_WAIT=60s

# Memory for the collector; its memory limiter works in shares of this.
# OTEL_COLLECTOR_MEMORY=1g

# Retention.
# PROMETHEUS_RETENTION=15d
# TEMPO_RETENTION=168h
# LOKI_RETENTION=168h

# Loki refuses writes when its disk passes this share full.
# LOKI_DISK_FULL_THRESHOLD=0.9

# Host ports, all bound to 127.0.0.1.
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# POSTGRES_PORT=5432
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
